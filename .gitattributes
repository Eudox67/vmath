# Normalize line endings on commit, adopt LF in the working tree.
* text=auto eol=lf

# Pascal and build sources must stay LF - CRLF breaks FPC string literals
# and shell scripts.
*.pas     text eol=lf
*.pp      text eol=lf
*.inc     text eol=lf
*.lpk     text eol=lf
*.lpi     text eol=lf
*.lpr     text eol=lf
*.xml     text eol=lf
*.sh      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.cfg     text eol=lf
*.py      text eol=lf
Makefile  text eol=lf

# Explicit binary markers (no EOL conversion, no text diffing)
*.so      binary
*.a       binary
*.o       binary
*.ppu     binary
*.exe     binary
*.dll     binary
*.dylib   binary
