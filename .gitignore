# ---------------------------------------------------------------------------
# vmath - double-precision matrix and numerical library for Free Pascal.
# Apache-2.0 - see LICENSE and NOTICE.
#
# Every rule below answers to a file this tree actually produces:
#   `fpc fpmake.pp && ./fpmake compile`  -> fpmake, fpmake.o, units/
#   `./fpmake install`                   -> *.fpm
#   `lazbuild vmath.lpk`                 -> lib/, vmath.pas, packagefiles.xml
#   `fpc @vmath.cfg tests/...`           -> *.o, *.ppu, *.rsj, the program
# ---------------------------------------------------------------------------

# Compiler output
*.o
*.ppu
*.a
*.or
*.rs
*.rsj
*.compiled
*.dcu

# Build directories (fpmake, lazbuild, hand builds)
/units/
/lib/
/bin/
/tests/units/

# Generated by fpmake and lazbuild
/fpmake
/fpmake.o
/*.fpm
/vmath.pas
/packagefiles.xml

# Editor and OS clutter
.vscode/
*.code-workspace
*.lps
ppas.sh
link.res
.DS_Store

# Local backups
*.bak
*.bk2
*.new
*.orig
*~
